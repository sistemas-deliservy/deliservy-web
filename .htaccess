# deliservy.com en Ferozo (Apache) — 24-oct-2026.
#
# La tienda del cliente y el seguimiento se abren AQUÍ (Gilberth: «vendedores, sus enlaces, la tienda del cliente y el
# seguimiento, todo en www.deliservy.com»):
#   /v/<codigo>      el enlace de un vendedor (6 a 16 minúsculas y cifras)
#   /pedido/<ficha>  el seguimiento de un pedido de la tienda web (la ficha firmada que da la API)
#   /p/<id>, /t/<id> el producto o la tienda que se comparte desde la APP (2.8.8 en adelante; antes iba a
#                    api.deliservy.site/api/compartir/p|t/<id>, que sigue igual). Con la app instalada, el teléfono los
#                    abre en la app por los archivos de `.well-known/` (apple-app-site-association y assetlinks.json).
# Las dos las pinta `tienda.php`, por dentro: le pide la página a la API (api.deliservy.site) y la devuelve tal cual,
# así que la barra del navegador sigue en www.deliservy.com. Lo demás de la web, como siempre.
#
# ⚠️ Si en Ferozo ya hay un .htaccess, JUNTAR estas reglas con las suyas (no reemplazarlo sin mirarlo).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Deliservy promotores (25-oct-2026). La página sigue en la carpeta vendedor/.
  # /vendedor salta a /promotores/. Los archivos (/vendedor/app.js) se quedan: la página los pide por ahí.
  RewriteRule ^vendedor/?$ /promotores/ [R=302,L]
  RewriteRule ^promotores/?$ /vendedor/index.html [L]
  RewriteRule ^v/[a-z0-9]{6,16}/?$ tienda.php [L]
  RewriteRule ^pedido/[A-Za-z0-9_-]{16,556}\.[A-Za-z0-9_-]{43}/?$ tienda.php [L]
  RewriteRule ^p/[0-9]{1,10}/?$ tienda.php [L]
  RewriteRule ^t/[0-9]{1,10}/?$ tienda.php [L]
</IfModule>

# Sin mod_rewrite, al menos que los enlaces lleguen a la tienda (en api.deliservy.site).
<IfModule !mod_rewrite.c>
  RedirectMatch 302 ^/v/([a-z0-9]{6,16})/?$ https://api.deliservy.site/api/compartir/v/$1
  RedirectMatch 302 ^/pedido/([A-Za-z0-9_-]{16,556}\.[A-Za-z0-9_-]{43})/?$ https://api.deliservy.site/api/compartir/pedido/$1
  RedirectMatch 302 ^/p/([0-9]{1,10})/?$ https://api.deliservy.site/api/compartir/p/$1
  RedirectMatch 302 ^/t/([0-9]{1,10})/?$ https://api.deliservy.site/api/compartir/t/$1
</IfModule>
